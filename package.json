{
  "name": "company-analyzer-ui",
  "version": "0.0.0",
  "main": "server/app.js",
  "type": "module",
  "scripts": {
    "dev": "yarn watch",
    "watch": "npm-run-all -p watch:build watch:start",
    "watch:build": "vite",
    "watch:start": "node --watch-path ./server/ --watch-path ./.env -r dotenv/config server/app.js",
    "start": "node --optimize_for_size server/app.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@primevue/core": "^4.4.1",
    "@primevue/forms": "^4.4.1",
    "@primevue/themes": "^4.4.1",
    "axios": "^1.13.1",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-es6-template-engine": "^2.2.3",
    "npm-run-all": "^4.1.5",
    "pinia": "^3.0.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "serve-favicon": "^2.5.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "sass-embedded": "^1.93.3",
    "vite": "^7.1.7"
  }
